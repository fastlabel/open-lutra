{
  "name": "OpenLUTRA",
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.devcontainer.yml", "docker-compose.claude.yml"],
  "service": "backend",
  "workspaceFolder": "/app",

  // Dynamically generate a docker-compose override for bind-mounting Claude conversation history from the host
  "initializeCommand": ".devcontainer/init-claude.sh",

  // Mount the host's ~/.claude into the container (shares API key, memory, and global settings)
  // Conversation history is mounted separately via docker-compose.claude.yml generated by init-claude.sh
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/root/.claude,type=bind"
  ],

  // Rebuild the venv
  "postCreateCommand": "bash -c 'source /opt/ros/$ROS_DISTRO/setup.bash && uv venv --system-site-packages --clear && uv sync'",

  "customizations": {
    "vscode": {
      "settings": {
        // Make Pylance recognize ROS2 packages such as rclpy
        "python.analysis.extraPaths": [
          "/opt/ros/humble/lib/python3.10/site-packages",
          "/opt/ros/jazzy/lib/python3.12/site-packages"
        ],
        // The backend container has no Node.js, so run Vitest/Biome extensions on the UI side instead
        "remote.extensionKind": {
          "vitest.explorer": ["ui"],
          "biomejs.biome": ["ui"]
        },
        // Disable port auto-detection and forwarding (ports are fixed by docker-compose ports definitions)
        "remote.autoForwardPorts": false,
        // Use the venv interpreter inside the container
        "python.defaultInterpreterPath": "/app/.venv/bin/python",
        "python.analysis.typeCheckingMode": "off",
        "python.analysis.diagnosticSeverityOverrides": {
          "reportMissingImports": "none"
        },
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff",
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.fixAll.ruff": "always",
            "source.organizeImports.ruff": "always"
          },
          "editor.rulers": [120]
        }
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "biomejs.biome",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "anthropic.claude-code"
      ]
    }
  }
}
