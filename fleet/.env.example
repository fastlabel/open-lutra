# Copy to .env (git-ignored) and uncomment to use an IAM user's access keys. They are used when
# a make target runs without AWS_VAULT_PROFILE and outside `aws-vault exec`. Give the user only
# the operator policy: add it to the group in `terraform output operator_group`.
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# Temporary keys (ASIA..., e.g. from the SSO portal) also need the session token.
# AWS_SESSION_TOKEN=...
AWS_REGION=ap-northeast-1

# Greengrass component name (reverse-domain style) and the publisher written in its recipe.
# A different name is a different component: its versions and deployment history start over.
# COMPONENT_NAME=com.example.OpenLutra
# COMPONENT_PUBLISHER=Example

# Infrastructure values, needed on machines without the Terraform state (it only lives where
# `terraform apply` ran). Copy them from `terraform output` there; scripts fall back to
# `terraform output` for any left unset.
# ECR_REGISTRY=<account id>.dkr.ecr.ap-northeast-1.amazonaws.com
# ARTIFACT_BUCKET=open-lutra-gg-artifacts-<account id>
# CORE_DEVICE_POLICY=open-lutra-gg-core-device
# TES_ROLE_ALIAS=open-lutra-gg-token-exchange
